<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The API runs over plain HTTP on the LAN / IIS, so cleartext traffic is allowed. -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSolar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".core.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".core.HomeActivity" />
        <activity
            android:name=".reservations.BookSlotActivity"
            android:label="@string/book_slot"
            android:parentActivityName=".core.HomeActivity" />
        <activity
            android:name=".reservations.BookingSummaryActivity"
            android:label="@string/booking_summary" />
    </application>

</manifest>
