<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- OutOfProcess + IIS app pool "No Managed Code": ANCM starts Kestrel. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <UserSecretsId>0304ea6e-a23e-4c44-9798-0c3e1e23c2c4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.Development.json.example" CopyToPublishDirectory="Never" />
    <Content Include="appsettings.Production.json.example" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
