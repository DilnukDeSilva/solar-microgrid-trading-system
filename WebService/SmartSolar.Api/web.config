<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the FAT service.
  App pool must be "No Managed Code". stdout logs go to ./logs for 502.5 diagnosis.
  Do not put Jwt:Key or Mongo passwords in this file (it is committed). Set them in
  IIS environment variables or a machine-local appsettings.Production.json.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\SmartSolar.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
