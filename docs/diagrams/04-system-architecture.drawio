          <mxGeometry x="620" y="55" width="420" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mob1" value="Activities / UI&#xa;Prosumer · Operator&#xa;Book · Map · Scan QR&#xa;Dashboard · History" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="clients">
