        <mxCell id="sqliteBox" value="SQLite&#xa;(offline only)&#xa;session · profile&#xa;booking cache&#xa;dashboard snapshot&#xa;my_reservations&#xa;stations_cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="clients">
          <mxGeometry x="1080" y="50" width="170" height="180" as="geometry" />
        </mxCell>

        <!-- Network bar -->
        <mxCell id="net" value="LAN  ·  HTTPS/HTTP  ·  REST / JSON  ·  Authorization: Bearer JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
