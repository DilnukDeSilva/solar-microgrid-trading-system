  </diagram>

  <diagram id="modules" name="Module Ownership">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Logical Modules (end-to-end ownership)" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="480" height="30" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="M1 — Identity &amp; Accounts&#xa;&#xa;API: login, users, prosumers, /me&#xa;Web: login, users, pending activate&#xa;Android: shell, login, profile&#xa;SQLite: session, user_profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="M2 — Nodes, Slots &amp; Maps (+ IIS)&#xa;&#xa;API: stations, slots, nearby&#xa;Web: station &amp; slot CRUD&#xa;Android: map + station list&#xa;SQLite: stations_cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="M3 — Reservations &amp; QR Dispatch&#xa;&#xa;API: create/update/cancel/approve&#xa;Web: book on behalf, edit, cancel&#xa;Android: book flow + show QR&#xa;SQLite: my_reservations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="M4 — Views, Dashboards &amp; Operator QR&#xa;&#xa;API: list/filter, pending, dashboards,&#xa;      verify-qr, complete&#xa;Web: Home dashboard, booking monitor&#xa;Android: dashboard, history, scan→finalise&#xa;SQLite: booking_history_cache, dashboard_snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="100" width="300" height="180" as="geometry" />
        </mxCell>

        <mxCell id="shared" value="Shared architecture rules&#xa;• Clients = UI only (no Mongo access, no rule enforcement)&#xa;• API Controllers thin → Services hold ALL rules → Repositories talk to Mongo&#xa;• JWT carries sub, role, nic — prosumer scope from token, not query string&#xa;• QR holds opaque token only — verify/complete on server (single-use)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=14;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="1280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="stack" value="Tech stack: C# / ASP.NET Core · MongoDB · ASP.NET MVC + Bootstrap · React/Tailwind (desk) · Android Java · SQLite · JWT · ZXing · Google Maps" style="text;html=1;align=center;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="150" y="500" width="1100" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
