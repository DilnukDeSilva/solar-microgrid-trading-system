        <mxCell id="a2b" value="read/write&#xa;cache" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#9673a6;fontSize=10;dashed=1;" edge="1" parent="1" source="mob2" target="sqliteBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== API ========== -->
        <mxCell id="api" value="Application Layer — C# ASP.NET Core Web API (FAT service, Windows / IIS)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;startSize=28;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="1280" height="320" as="geometry" />
        </mxCell>

        <mxCell id="ctrl" value="Controllers (thin)&#xa;&#xa;Auth · Users · Prosumers&#xa;Stations · Slots&#xa;Reservations&#xa;Dashboard · Operator&#xa;&#xa;HTTP in → DTO out&#xa;No business rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="api">
          <mxGeometry x="40" y="50" width="220" height="230" as="geometry" />
        </mxCell>

        <mxCell id="svc" value="Services (ALL rules)&#xa;&#xa;Auth / JWT&#xa;Account &amp; Prosumer rules&#xa;Station &amp; Slot rules&#xa;Reservation create/approve&#xa;Query / Dashboard&#xa;QR verify &amp; complete&#xa;&#xa;SriLankaClock · Error codes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=top;spacingTop=8;strokeWidth=2;" vertex="1" parent="api">
          <mxGeometry x="320" y="50" width="260" height="230" as="geometry" />
        </mxCell>

        <mxCell id="repo" value="Repositories&#xa;&#xa;UserRepository&#xa;StationRepository&#xa;SlotRepository&#xa;ReservationRepository&#xa;ReservationQueryRepository&#xa;&#xa;Mongo filters only&#xa;No business rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="api">
          <mxGeometry x="640" y="50" width="240" height="230" as="geometry" />
        </mxCell>

        <mxCell id="cross" value="Cross-cutting&#xa;&#xa;JWT Bearer auth&#xa;Role authorization&#xa;CORS&#xa;Swagger&#xa;Active-account guard&#xa;ApiException → error DTO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="api">
          <mxGeometry x="940" y="50" width="200" height="230" as="geometry" />
        </mxCell>

        <mxCell id="flowApi" value="Controllers → Services → Repositories" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#666666;align=center;" vertex="1" parent="api">
          <mxGeometry x="320" y="285" width="280" height="20" as="geometry" />
        </mxCell>

        <!-- arrows inside API -->
        <mxCell id="b1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="ctrl" target="svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="svc" target="repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- net to api -->
        <mxCell id="a3" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="net" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== DATA ========== -->
        <mxCell id="data" value="Data Layer — MongoDB (SmartSolar)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;startSize=28;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="820" width="1280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="cUsers" value="Users&#xa;identity · roles · status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="data">
          <mxGeometry x="60" y="50" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cStn" value="SolarStationInfo&#xa;GPS · capacity · schedule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="data">
          <mxGeometry x="340" y="50" width="240" height="80" as="geometry" />
