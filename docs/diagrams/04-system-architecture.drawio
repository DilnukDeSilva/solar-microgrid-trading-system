        </mxCell>
        <mxCell id="cRes" value="EnergyReservation&#xa;booking · status · qrToken" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="data">
