<mxfile host="app.diagrams.net" agent="SmartSolar" version="22.1.0">
  <diagram id="arch" name="System Architecture">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Smart Solar Microgrid Trading System — Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="620" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Clients talk only through REST/JSON. Business rules live in the API (FAT service). MongoDB is the source of truth." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="55" width="820" height="28" as="geometry" />
        </mxCell>

        <!-- ========== CLIENTS ========== -->
        <mxCell id="clients" value="Presentation / Client Layer" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;startSize=28;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="1280" height="260" as="geometry" />
        </mxCell>

        <mxCell id="webBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="clients">
          <mxGeometry x="50" y="50" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="webTitle" value="Web Clients (Browser)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=14;fontColor=#1a3a6b;" vertex="1" parent="clients">
          <mxGeometry x="50" y="55" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="web1" value="ASP.NET Core MVC&#xa;Bootstrap 5&#xa;Bookings · Dashboards · Stations&#xa;Reservations · Users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="clients">
          <mxGeometry x="70" y="90" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="web2" value="React + Tailwind&#xa;(smartsolar-ui)&#xa;Desk UI · API client only&#xa;No business rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="clients">
          <mxGeometry x="320" y="90" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="mobBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="clients">
          <mxGeometry x="620" y="50" width="420" height="180" as="geometry" />
