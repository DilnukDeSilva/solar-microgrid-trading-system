        <mxCell id="mob2" value="ApiClient&#xa;JWT session&#xa;ZXing QR&#xa;Google Maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="clients">
