        </mxCell>

        <mxCell id="footer" value="Hosting: API on Windows IIS (or local Kestrel for lab). Clients on LAN. Android uses 10.0.2.2 (emulator) or machine IP (phone)." style="text;html=1;fontSize=11;fontColor=#666666;align=center;" vertex="1" parent="1">
