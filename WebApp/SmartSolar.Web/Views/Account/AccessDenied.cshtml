@{
    ViewData["Title"] = "Access denied";
}

<div class="decision">
    <p class="eyebrow">Access</p>
    <h1>This desk is not for that role</h1>
    <p class="lede mb-4">Backoffice and Grid Operator see different menus. Prosumer accounts sign in on the Android app. Log out and use a staff account if you landed here by mistake.</p>
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        <button type="submit" class="btn btn-primary">Log out</button>
    </form>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Home</a>
</div>
