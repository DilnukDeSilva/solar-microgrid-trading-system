@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="gate">
    <partial name="_BrandPanel" />
    <section class="gate-pane">
        <div class="gate-card">
            <p class="eyebrow">Staff access</p>
            <h2>Log in</h2>
            <p class="lede mb-4">Username, or a prosumer NIC if you are checking that mobile accounts stay off this desk.</p>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger notice" role="alert"></div>
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" autofocus placeholder="admin" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <button class="btn btn-outline-secondary" type="button" data-toggle-password="#Password">Show</button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Enter the desk</button>
            </form>
            <p class="seed-note mb-0"><a asp-controller="Home" asp-action="Index">Back to the opening screen</a></p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
