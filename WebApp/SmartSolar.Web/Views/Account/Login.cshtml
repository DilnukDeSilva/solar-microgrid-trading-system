@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center py-4">
    <div class="col-md-5 col-lg-4">
        <div class="card auth-card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-2">Staff log in</h1>
                <p class="text-muted mb-4">Backoffice and Grid Operator accounts. Prosumers use the Android app.</p>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Log in</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
