@model (IReadOnlyList<AvailableSlotDto> Slots, string? Selected)

@foreach (var day in Model.Slots.GroupBy(s => s.StartTime.ToSriLanka().Date))
{
    <div class="mb-3">
        <div class="small fw-semibold text-muted mb-2">@day.Key.ToString("dddd, dd MMMM")</div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var slot in day)
            {
                <input type="radio" class="btn-check" name="SlotId" id="slot-@slot.Id" value="@slot.Id" autocomplete="off" checked="@(slot.Id == Model.Selected)" required />
                <label class="btn btn-outline-success" for="slot-@slot.Id">
                    @slot.StartTime.ToSriLanka().ToString("HH:mm") – @slot.EndTime.ToSriLanka().ToString("HH:mm")
                </label>
            }
        </div>
    </div>
}
