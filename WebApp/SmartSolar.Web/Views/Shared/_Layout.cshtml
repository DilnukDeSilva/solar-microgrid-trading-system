<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Smart Solar") · Smart Solar</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartSolar.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)) return "";
        if (action != null && !string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) return "";
        return "active";
    }
}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-brand-bg">
            <div class="container-fluid px-3">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index"><span class="sun-mark me-2"></span>Smart Solar</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole(RoleNames.Backoffice))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Admin")" asp-controller="Admin" asp-action="Index">Dashboard</a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.GridOperator))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Operations")" asp-controller="Operations" asp-action="Index">Dashboard</a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.Backoffice) || User.IsInRole(RoleNames.GridOperator))
                        {
                            var peopleActive = Active("Users") != "" || Active("Prosumers") != "" || Active("PendingActivations") != "" ? "active" : "";
                            var bookingsActive = Active("Bookings") != "" || Active("Reservations") != "" ? "active" : "";
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @peopleActive" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    People
                                    @if (User.IsInRole(RoleNames.Backoffice))
                                    {
                                        @await Component.InvokeAsync("PendingActivationBadge")
                                    }
                                </a>
                                <ul class="dropdown-menu">
                                    @if (User.IsInRole(RoleNames.Backoffice))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Staff users</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Prosumers" asp-action="Index">Prosumers</a></li>
                                    @if (User.IsInRole(RoleNames.Backoffice))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="PendingActivations" asp-action="Index">
                                                Pending activations
                                                @await Component.InvokeAsync("PendingActivationBadge")
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                            var stationsActive = Active("Stations") != "" || Active("Slots") != "" ? "active" : "";
                            <li class="nav-item">
                                <a class="nav-link @stationsActive" asp-controller="Stations" asp-action="Index">Stations</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @bookingsActive" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Bookings</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Bookings" asp-action="Index">Booking monitor</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reservations" asp-action="Index">Manage reservations</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reservations" asp-action="Create">Book for a prosumer</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var roleLabel = User.IsInRole(RoleNames.Backoffice) ? "Backoffice" : "Grid operator";
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity.Name · @roleLabel</a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-muted">Signed in as @User.Identity.Name</span></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                            <button type="submit" class="btn btn-link p-0">Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-auto bg-light">
        <div class="container small text-muted">
            Smart Solar Microgrid Trading System · SE4040
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
