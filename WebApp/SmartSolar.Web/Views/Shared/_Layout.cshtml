<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Smart Solar") · Smart Solar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,640&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartSolar.Web.styles.css" asp-append-version="true" />
</head>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string controller) => string.Equals(current, controller, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
    var roleLabel = User.IsInRole(RoleNames.Backoffice) ? "Backoffice" : User.IsInRole(RoleNames.GridOperator) ? "Grid operator" : "Staff";
}
<body class="@(signedIn ? "is-app" : "is-public")">
@if (signedIn)
{
    <div class="app-frame">
        <aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appNav" aria-label="Desk navigation">
            <div class="offcanvas-header">
                <span class="brand-title">Smart Solar</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
            </div>
            <div class="offcanvas-body">
                <div class="sidebar-panel">
                    <a class="brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark" aria-hidden="true">
                            <svg viewBox="0 0 32 32" fill="none">
                                <circle cx="16" cy="16" r="5.5" fill="#e39b16"/>
                                <g stroke="#e39b16" stroke-width="2" stroke-linecap="round">
                                    <path d="M16 3.5v3.2M16 25.3v3.2M3.5 16h3.2M25.3 16h3.2M7.2 7.2l2.3 2.3M22.5 22.5l2.3 2.3M24.8 7.2l-2.3 2.3M9.5 22.5l-2.3 2.3"/>
                                </g>
                            </svg>
                        </span>
                        <span>
                            <span class="brand-title">Smart Solar</span>
                            <span class="brand-sub">Microgrid desk</span>
                        </span>
                    </a>

                    <p class="side-label">Desk</p>
                    @if (User.IsInRole(RoleNames.Backoffice))
                    {
                        <a class="side-link @Active("Admin")" asp-controller="Admin" asp-action="Index">Dashboard</a>
                    }
                    @if (User.IsInRole(RoleNames.GridOperator))
                    {
                        <a class="side-link @Active("Operations")" asp-controller="Operations" asp-action="Index">Operations</a>
                    }

                    <p class="side-label">Accounts</p>
                    @if (User.IsInRole(RoleNames.Backoffice))
                    {
                        <a class="side-link @Active("Users")" asp-controller="Users" asp-action="Index">Staff users</a>
                    }
                    @if (User.IsInRole(RoleNames.Backoffice) || User.IsInRole(RoleNames.GridOperator))
                    {
                        <a class="side-link @Active("Prosumers")" asp-controller="Prosumers" asp-action="Index">Prosumers</a>
                    }
                    @if (User.IsInRole(RoleNames.Backoffice))
                    {
                        @await Component.InvokeAsync("PendingActivationBadge")
                    }

                    @if (User.IsInRole(RoleNames.Backoffice) || User.IsInRole(RoleNames.GridOperator))
                    {
                        <p class="side-label">Trading</p>
                        <a class="side-link @Active("Reservations")" asp-controller="Reservations" asp-action="Create">Book a slot</a>
                    }

                    <div class="sidebar-user">
                        <div class="who">@User.Identity?.Name</div>
                        <div class="who-role">@roleLabel</div>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-light btn-sm logout-btn">Log out</button>
                        </form>
                    </div>
                </div>
            </div>
        </aside>

        <div class="app-stage">
            <header class="app-topbar d-lg-none">
                <button class="btn btn-outline-light btn-sm menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#appNav" aria-controls="appNav">Menu</button>
                <span class="brand-title">Smart Solar</span>
            </header>
            <main class="app-content">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
            <footer class="app-footer">Smart Solar Microgrid Trading System · this desk talks to the API only</footer>
        </div>
    </div>
}
else
{
    <partial name="_Alerts" />
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
