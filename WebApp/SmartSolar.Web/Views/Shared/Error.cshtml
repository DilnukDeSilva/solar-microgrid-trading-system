@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h4">Something went wrong</h1>
<p>The page could not be shown.</p>
@if (Model.ShowRequestId)
{
    <p class="text-muted">Reference <code>@Model.RequestId</code></p>
}
<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to dashboard</a>
