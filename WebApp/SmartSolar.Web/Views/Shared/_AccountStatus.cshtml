@model string
@{
    var css = (Model ?? "").ToLowerInvariant() switch
    {
        "active" or "approved" or "available" => "badge-status-approved",
        "pending" => "badge-status-pending",
        "completed" => "badge-status-completed",
        _ => "badge-status-muted"
    };
}
<span class="badge badge-status @css">@(string.IsNullOrWhiteSpace(Model) ? "Unknown" : Model)</span>
