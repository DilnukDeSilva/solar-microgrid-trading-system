@model string
@{
    var css = Model switch
    {
        "Pending" => "badge-status-pending",
        "Approved" or "Active" or "Available" => "badge-status-approved",
        "Completed" => "badge-status-completed",
        _ => "badge-status-muted"
    };
}
<span class="badge badge-status @css">@Model</span>
