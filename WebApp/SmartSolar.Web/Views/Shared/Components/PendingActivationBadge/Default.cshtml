@model IReadOnlyList<UserDto>
@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var active = string.Equals(current, "PendingActivations", StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<a class="nav-link @active" asp-controller="PendingActivations" asp-action="Index">
    Pending activations
    @if (Model.Count > 0) { <span class="badge rounded-pill bg-warning text-dark">@Model.Count</span> }
</a>
