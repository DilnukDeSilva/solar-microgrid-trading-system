@model IReadOnlyList<UserDto>
@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var active = string.Equals(current, "PendingActivations", StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
}
<a class="side-link @active" asp-controller="PendingActivations" asp-action="Index">
    <span>Pending activations</span>
    @if (Model.Count > 0)
    {
        <span class="count-pill">@Model.Count</span>
    }
</a>
