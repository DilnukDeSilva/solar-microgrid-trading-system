@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-3">Backoffice dashboard</h1>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning" role="alert">Counts could not be loaded. @Model.LoadError</div>
}

<partial name="_OperationsDashboard" model="Model.Operations" />

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Staff accounts</div>
                <div class="fs-3">@Model.StaffCount</div>
                <a class="stretched-link" asp-controller="Users" asp-action="Index"></a>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Prosumers</div>
                <div class="fs-3">@Model.ProsumerCount</div>
                <a class="stretched-link" asp-controller="Prosumers" asp-action="Index"></a>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Active prosumers</div>
                <div class="fs-3">@Model.ActiveProsumerCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Awaiting activation</div>
                <div class="fs-3">@Model.PendingCount</div>
                <a class="stretched-link" asp-controller="PendingActivations" asp-action="Index"></a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Staff users</h2>
                <p class="text-muted">Create, update and deactivate Backoffice and Grid Operator accounts.</p>
                <a class="btn btn-primary" asp-controller="Users" asp-action="Index">Manage users</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Bookings</h2>
                <p class="text-muted">Filter today's work, the approval queue and booking history.</p>
                <a class="btn btn-outline-primary" asp-controller="Bookings" asp-action="Index">Open monitor</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Reservations</h2>
                <p class="text-muted">List, edit, cancel or approve bookings through the API rules.</p>
                <a class="btn btn-outline-primary" asp-controller="Reservations" asp-action="Index">Open list</a>
            </div>
        </div>
    </div>
</div>
