@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Backoffice</p>
        <h1>Account desk</h1>
        <p class="lede">Live booking counts, staff accounts, solar prosumers, and registrations waiting to be switched on.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning notice" role="alert">Counts could not be loaded. @Model.LoadError</div>
}

<partial name="_OperationsDashboard" model="Model.Operations" />

<div class="stat-grid mb-4">
    <a class="panel stat" asp-controller="Users" asp-action="Index">
        <div class="stat-value">@Model.StaffCount</div>
        <div class="stat-label">Staff accounts</div>
    </a>
    <a class="panel stat" asp-controller="Prosumers" asp-action="Index">
        <div class="stat-value">@Model.ProsumerCount</div>
        <div class="stat-label">Prosumers</div>
    </a>
    <a class="panel stat" asp-controller="Prosumers" asp-action="Index" asp-route-status="Active">
        <div class="stat-value">@Model.ActiveProsumerCount</div>
        <div class="stat-label">Active prosumers</div>
    </a>
    <a class="panel stat" asp-controller="PendingActivations" asp-action="Index">
        <div class="stat-value">@Model.PendingCount</div>
        <div class="stat-label">Awaiting activation</div>
    </a>
</div>

<div class="link-grid">
    <a class="panel panel-pad link-card" asp-controller="Bookings" asp-action="Index">
        <p class="eyebrow">Trading</p>
        <h2 class="h4">Booking monitor</h2>
        <p class="text-muted mb-0">Filter today's work, the approval queue and booking history.</p>
    </a>
    <a class="panel panel-pad link-card" asp-controller="Users" asp-action="Create">
        <p class="eyebrow">Staff</p>
        <h2 class="h4">New staff account</h2>
        <p class="text-muted mb-0">Create a Backoffice officer or a Grid Operator. Passwords are hashed by the API.</p>
    </a>
    <a class="panel panel-pad link-card" asp-controller="Prosumers" asp-action="Create">
        <p class="eyebrow">Prosumers</p>
        <h2 class="h4">Register a prosumer</h2>
        <p class="text-muted mb-0">NIC is the key. An account created here is Active immediately.</p>
    </a>
    <a class="panel panel-pad link-card" asp-controller="PendingActivations" asp-action="Index">
        <p class="eyebrow">Approvals</p>
        <h2 class="h4">Pending activations</h2>
        <p class="text-muted mb-0">Self-registered mobile accounts stay Pending until you activate or reject them.</p>
    </a>
    <a class="panel panel-pad link-card" asp-controller="Reservations" asp-action="Create">
        <p class="eyebrow">Trading</p>
        <h2 class="h4">Book a slot</h2>
        <p class="text-muted mb-0">Reserve a charging window for a prosumer who calls or visits the office.</p>
    </a>
</div>
