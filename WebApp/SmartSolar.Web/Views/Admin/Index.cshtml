@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-3">Backoffice dashboard</h1>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning" role="alert">Counts could not be loaded. @Model.LoadError</div>
}

<partial name="_OperationsDashboard" model="Model.Operations" />

@if (Model.PendingCount > 0)
{
    <a class="card tile-attention text-decoration-none text-body mb-4" asp-controller="PendingActivations" asp-action="Index">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="small text-muted">Awaiting activation</div>
                <div class="tile-number">@Model.PendingCount</div>
            </div>
            <span>Open queue</span>
        </div>
    </a>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Staff users</h2>
                <p class="text-muted">Create, update and deactivate staff accounts.</p>
                <a class="btn btn-primary" asp-controller="Users" asp-action="Index">Manage users</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Bookings</h2>
                <p class="text-muted">Filter today's work, the approval queue and booking history.</p>
                <a class="btn btn-outline-primary" asp-controller="Bookings" asp-action="Index">Open monitor</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Reservations</h2>
                <p class="text-muted">List, edit, cancel or approve bookings.</p>
                <a class="btn btn-outline-primary" asp-controller="Reservations" asp-action="Index">Open list</a>
            </div>
        </div>
    </div>
</div>
