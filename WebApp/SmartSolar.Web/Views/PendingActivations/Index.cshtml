@model IReadOnlyList<UserDto>
@{
    ViewData["Title"] = "Pending activations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Pending activations</h1>
        <p class="text-muted mb-0">Registrations waiting for a Backoffice decision.</p>
    </div>
    <span class="badge badge-status badge-status-pending">@Model.Count waiting</span>
</div>
<div class="card">
<table class="table table-hover align-middle mb-0 table-stack">
    <thead><tr><th>NIC</th><th>Name</th><th>Username</th><th>Contact</th><th class="text-end">Decision</th></tr></thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="5" class="text-muted">No accounts are waiting. New phone registrations appear here.</td></tr>
    }
    @foreach (var user in Model)
    {
        <tr>
            <td data-label="NIC">@user.Nic</td>
            <td data-label="Name">@user.FullName</td>
            <td data-label="Username">@user.Username</td>
            <td data-label="Contact">@user.Email<br /><span class="text-muted">@user.Phone</span></td>
            <td class="text-end text-nowrap">
                <form asp-action="Activate" asp-route-id="@user.Nic" method="post" class="d-inline"><button class="btn btn-sm btn-primary">Activate</button></form>
                <form asp-action="Reject" asp-route-id="@user.Nic" method="post" class="d-inline" onsubmit="return confirm('Reject and deactivate this registration?');"><button class="btn btn-sm btn-outline-danger">Reject</button></form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
