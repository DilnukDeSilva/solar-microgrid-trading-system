@model IReadOnlyList<UserDto>
@{
    ViewData["Title"] = "Pending activations";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Approvals</p>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <h1>Pending activations</h1>
            <span class="status status-pending">@Model.Count waiting</span>
        </div>
        <p class="lede">These prosumers registered on the phone. Activate them so they can log in, or reject the registration.</p>
    </div>
</div>

<div class="panel table-responsive">
    <table class="table table-hover data-table align-middle mb-0">
        <thead>
            <tr>
                <th>Prosumer</th>
                <th>NIC</th>
                <th>Username</th>
                <th>Contact</th>
                <th class="text-end">Decision</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5"><div class="empty">No accounts are waiting for activation.</div></td>
            </tr>
        }
        @foreach (var user in Model)
        {
            var initial = string.IsNullOrWhiteSpace(user.FullName) ? "?" : user.FullName.Trim()[0].ToString().ToUpperInvariant();
            <tr>
                <td>
                    <div class="person">
                        <span class="avatar" aria-hidden="true">@initial</span>
                        <span>@user.FullName</span>
                    </div>
                </td>
                <td class="mono">@user.Nic</td>
                <td>@user.Username</td>
                <td>
                    <div>@user.Email</div>
                    <div class="text-muted small">@user.Phone</div>
                </td>
                <td class="text-end text-nowrap">
                    <form asp-action="Activate" asp-route-id="@user.Nic" method="post" class="d-inline">
                        <button class="btn btn-sm btn-success" type="submit">Activate</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@user.Nic" method="post" class="d-inline" onsubmit="return confirm('Reject this registration? The account will be deactivated.');">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Reject</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
