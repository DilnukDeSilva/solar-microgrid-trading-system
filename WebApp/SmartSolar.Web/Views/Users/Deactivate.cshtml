@model UserDto
@{
    ViewData["Title"] = "Deactivate user";
}

<div class="decision">
    <p class="eyebrow">Staff</p>
    <h1>Deactivate @Model.Username?</h1>
    <p class="lede">The API sets the status to Deactivated. That account can no longer log in. You cannot deactivate the account you are using.</p>
    <div class="panel panel-pad my-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9"><partial name="_AccountStatus" model="Model.Role" /></dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><partial name="_AccountStatus" model="Model.Status" /></dd>
        </dl>
    </div>
    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-danger">Deactivate account</button>
    </form>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</div>
