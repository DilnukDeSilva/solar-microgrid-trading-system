@model StaffUserForm
@{
    ViewData["Title"] = "Edit staff account";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Staff</p>
        <h1>Edit @Model.Username</h1>
        <p class="lede">Username stays fixed. You cannot change your own role from this account if you are editing yourself.</p>
    </div>
</div>

<div class="panel panel-pad">
    <partial name="_Form" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
