@model IReadOnlyList<UserDto>
@{
    ViewData["Title"] = "Staff users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Staff users</h1>
        <p class="text-muted mb-0">Backoffice and Grid Operator accounts.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New staff account</a>
</div>

<div class="card">
    <table class="table table-hover align-middle mb-0 table-stack">
        <thead>
            <tr>
                <th>Username</th>
                <th>Name</th>
                <th>Role</th>
                <th>Status</th>
                <th>Email</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-muted">No staff accounts yet. New accounts appear here.</td>
            </tr>
        }
        @foreach (var user in Model)
        {
            <tr>
                <td data-label="Username">@user.Username</td>
                <td data-label="Name">@user.FullName</td>
                <td data-label="Role"><partial name="_AccountStatus" model="user.Role" /></td>
                <td data-label="Status"><partial name="_AccountStatus" model="user.Status" /></td>
                <td data-label="Email">@user.Email</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                    @if (user.Status != "Deactivated")
                    {
                        <a class="btn btn-sm btn-outline-danger" asp-action="Deactivate" asp-route-id="@user.Id">Deactivate</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
