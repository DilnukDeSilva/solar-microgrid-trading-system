@model IReadOnlyList<UserDto>
@{
    ViewData["Title"] = "Staff users";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Backoffice</p>
        <h1>Staff users</h1>
        <p class="lede">Backoffice officers and Grid Operators. You cannot deactivate your own account.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New staff account</a>
</div>

<div class="panel table-responsive">
    <table class="table table-hover data-table align-middle mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Username</th>
                <th>Role</th>
                <th>Status</th>
                <th>Contact</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6"><div class="empty">No staff accounts came back from the API.</div></td>
            </tr>
        }
        @foreach (var user in Model)
        {
            var initial = string.IsNullOrWhiteSpace(user.FullName) ? "?" : user.FullName.Trim()[0].ToString().ToUpperInvariant();
            <tr>
                <td>
                    <div class="person">
                        <span class="avatar" aria-hidden="true">@initial</span>
                        <span>@user.FullName</span>
                    </div>
                </td>
                <td class="mono">@user.Username</td>
                <td><partial name="_AccountStatus" model="user.Role" /></td>
                <td><partial name="_AccountStatus" model="user.Status" /></td>
                <td>
                    <div>@user.Email</div>
                    <div class="text-muted small">@user.Phone</div>
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                    @if (user.Status != "Deactivated")
                    {
                        <a class="btn btn-sm btn-outline-danger" asp-action="Deactivate" asp-route-id="@user.Id">Deactivate</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
