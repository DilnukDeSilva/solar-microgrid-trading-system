@model IReadOnlyList<UserDto>
@{
    ViewData["Title"] = "Staff users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Staff users</h1>
    <a class="btn btn-primary" asp-action="Create">New staff account</a>
</div>

<div class="table-responsive card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Username</th>
                <th>Name</th>
                <th>Role</th>
                <th>Status</th>
                <th>Email</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-muted">No staff accounts returned.</td>
            </tr>
        }
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.FullName</td>
                <td>@user.Role</td>
                <td>
                    @if (user.Status == "Active")
                    {
                        <span class="badge text-bg-success">@user.Status</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">@user.Status</span>
                    }
                </td>
                <td>@user.Email</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                    @if (user.Status != "Deactivated")
                    {
                        <a class="btn btn-sm btn-outline-danger" asp-action="Deactivate" asp-route-id="@user.Id">Deactivate</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
