@model IReadOnlyList<StationDto>
@{
    ViewData["Title"] = "Stations";
    var isBackoffice = User.IsInRole(RoleNames.Backoffice);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stations</h1>
    @if (isBackoffice)
    {
        <a asp-action="Create" class="btn btn-primary">Create station</a>
    }
</div>
<div class="card">
<table class="table table-hover align-middle mb-0 table-stack">
    <thead>
        <tr>
            <th>Name</th>
            <th>GPS</th>
            <th>Capacity (kWh)</th>
            <th>Battery slots</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="6" class="text-center text-muted py-4">No stations found.</td></tr>
    }
    @foreach (var station in Model)
    {
        <tr>
            <td data-label="Name">@station.Name</td>
            <td data-label="Location" class="font-monospace">@station.Latitude.ToString("0.0000"), @station.Longitude.ToString("0.0000")</td>
            <td data-label="Capacity">@station.CapacityKwh</td>
            <td data-label="Batteries">@station.BatterySlotsTotal</td>
            <td data-label="Status"><partial name="_AccountStatus" model="station.Status" /></td>
            <td class="text-end text-nowrap">
                <a asp-controller="Slots" asp-action="Index" asp-route-stationId="@station.Id" class="btn btn-sm btn-outline-primary">Slots</a>
                @if (isBackoffice)
                {
                    <div class="dropdown d-inline">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-label="More actions">⋯</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@station.Id">Edit</a></li>
                            <li>
                                @if (station.Status == "Active")
                                {
                                    <form asp-action="Deactivate" asp-route-id="@station.Id" method="post" onsubmit="return confirm('Deactivate this station?');">
                                        <button class="dropdown-item text-danger" type="submit">Deactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@station.Id" method="post">
                                        <button class="dropdown-item" type="submit">Activate</button>
                                    </form>
                                }
                            </li>
                        </ul>
                    </div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
