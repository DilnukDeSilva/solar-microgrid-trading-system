@model OperationsDashboardDto
@{
    ViewData["Title"] = "Operations";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Grid operator</p>
        <h1>Operations desk</h1>
        <p class="lede">Today's bookings, pending approvals, and tools to look up a prosumer or book a slot.</p>
    </div>
</div>

<partial name="_OperationsDashboard" model="Model" />

<div class="link-grid">
    <a class="panel panel-pad link-card" asp-controller="Bookings" asp-action="Index">
        <p class="eyebrow">Trading</p>
        <h2 class="h4">Booking monitor</h2>
        <p class="text-muted mb-0">Filter the queue, verify a QR token, and finalise completed jobs.</p>
    </a>
    <a class="panel panel-pad link-card" asp-controller="Prosumers" asp-action="Index">
        <p class="eyebrow">Accounts</p>
        <h2 class="h4">Find a prosumer</h2>
        <p class="text-muted mb-0">Search by NIC, name, username or phone. Reactivation stays with Backoffice.</p>
    </a>
    <a class="panel panel-pad link-card" asp-controller="Reservations" asp-action="Create">
        <p class="eyebrow">Trading</p>
        <h2 class="h4">Book a slot</h2>
        <p class="text-muted mb-0">Choose the prosumer, the station and a free window. The API enforces the booking rules.</p>
    </a>
</div>
