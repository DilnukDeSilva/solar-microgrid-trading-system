@model ProsumerForm
@{ ViewData["Title"] = "Create prosumer"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Create prosumer</h1><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>
<p class="text-muted">Staff-created prosumer accounts are active immediately.</p>
<form method="post" class="card card-body shadow-sm">
    <partial name="_Form" model="Model" />
    <div class="mt-4"><button class="btn btn-primary" type="submit">Create active account</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
